// Parent Grade Portal: one Worker serves both pages and the API.
// Production: grades.reportcard-ph.workers.dev. Dev (env "dev", fake data):
// grades-dev.reportcard-ph.workers.dev. The KV ids are not secret.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "grades",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-01",
	"workers_dev": true,
	// Static pages, built by Vite from index.html, teacher.html and privacy.html.
	// Everything under /api/ goes to the Worker first.
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Classes, rosters and grades. Read often, written rarely.
	"kv_namespaces": [
		{
			"binding": "DATA",
			"id": "55da82290c1945abb2604cf3f48e93ac"
		}
	],
	// Sessions and access codes. Strongly consistent, so sign-outs and
	// reissued codes take effect at once.
	"durable_objects": {
		"bindings": [
			{
				"name": "GATE",
				"class_name": "Gate"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Gate"
			]
		}
	],
	// Access code attempts. Generous per visitor, because many parents share
	// one connection on mobile data and school Wi-Fi.
	"ratelimits": [
		{
			"name": "TRIES_PER_VISITOR",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "TRIES_SITE_WIDE",
			"namespace_id": "1002",
			"simple": {
				"limit": 300,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"dev": {
			"name": "grades-dev",
			"kv_namespaces": [
				{
					"binding": "DATA",
					"id": "95e04d2fbc6c4177966c264cd65eace6"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "GATE",
						"class_name": "Gate"
					}
				]
			},
			"ratelimits": [
				{
					"name": "TRIES_PER_VISITOR",
					"namespace_id": "2001",
					"simple": {
						"limit": 20,
						"period": 60
					}
				},
				{
					"name": "TRIES_SITE_WIDE",
					"namespace_id": "2002",
					"simple": {
						"limit": 300,
						"period": 60
					}
				}
			]
		}
	}
}