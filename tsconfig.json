{
  // The Worker, its tests and the shared grade code. The React pages are
  // checked by tsconfig.app.json.
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "paths": { "@/*": ["./web/*"] }
  },
  "include": ["src/**/*", "test/**/*", "shared/**/*", "worker-configuration.d.ts"]
}
